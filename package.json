{
  "name": "@lapis-notes/lapis-plugin-docs",
  "version": "0.1.0",
  "description": "Lapis Notes Docs workspace: notes, books, cards, and FSRS review",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugin-docs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm spec:validate && pnpm check:app-ownership && pnpm check:no-tailwind && pnpm check:svelte && pnpm check:types",
    "check:app-ownership": "vitest run --project unit src/lib/application-ownership.test.ts",
    "check:no-tailwind": "node scripts/check-no-tailwind.mjs",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:storybook": "vitest run --project storybook",
    "build-storybook": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --config-dir .storybook --output-dir storybook-static",
    "publint": "publint",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check && pnpm check:app-ownership",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate",
    "storybook": "WATCHPACK_POLLING=250 node scripts/storybook-run.mjs --no-open --config-dir .storybook",
    "storybook:stop": "bash scripts/storybook-stop.sh",
    "storybook:restart": "bash scripts/storybook-restart.sh"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*",
    "!dist/**/*.example-sources.*",
    "!dist/**/*.story-play.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@libsql/client": "^0.18.0",
    "@lucide/svelte": "^0.523.0",
    "fflate": "^0.8.3",
    "ts-fsrs": "^5.4.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lapis-notes/api": "^0.2.6",
    "@lapismd/design-core": "^0.12.1",
    "@lapismd/mira": "~0.1.4",
    "@lapismd/mira-editor": "~0.0.3",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/source-code-pro": "5.2.7",
    "@lapis-notes/api": "0.2.6",
    "@lapis-notes/file-explorer": "0.2.2",
    "@lapis-notes/markdown": "0.2.2",
    "@lapis-notes/search": "0.1.5",
    "@lapis-notes/ui": "0.1.7",
    "@lapis-notes/workspace": "0.3.4",
    "@lapismd/design-core": "0.12.1",
    "@lapismd/mira": "0.1.4",
    "@lapismd/mira-editor": "~0.0.3",
    "@lapismd/spec-validator": "^0.2.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.1.12",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "^22.15.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "aria-query": "5.3.2",
    "bits-ui": "2.20.2",
    "publint": "0.3.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "tailwindcss": "4.1.12",
    "typescript": "~5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@lapismd/design-core": "0.12.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@lapismd/design-core": "0.12"
      }
    }
  }
}
